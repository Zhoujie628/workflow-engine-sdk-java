<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for the workflow engine.
  These patterns are either intentional design choices or false positives
  for this codebase's patterns. Clean up over time; new findings still block verify.
-->
<FindBugsFilter>
    <!-- Returning/storing mutable collections in builders, records and config accessors is
         the intended API surface; defensive copies are made at trust boundaries. -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
            <Bug pattern="EI_EXPOSE_REP2_EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- Java serialization is not used by this project. -->
    <Match>
        <Or>
            <Bug pattern="SE_BAD_FIELD"/>
            <Bug pattern="SE_NO_SERIALVERSIONID"/>
        </Or>
    </Match>

    <!-- Throwing from constructors: no finalizers in this codebase, finalizer attack N/A. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Single-use SecureRandom: fresh instance per AES-GCM IV is intentional and safe. -->
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>

    <!-- Duplicated branch bodies in normalization (kept for symmetry with sibling branches). -->
    <Match>
        <Bug pattern="DB_DUPLICATE_BRANCHES"/>
    </Match>

    <!-- CompletableFuture exception paths in WorkflowExecutor intentionally ignore
         secondary failures when aggregating step results. -->
    <Match>
        <Bug pattern="DM_DEFAULT_ENCODING,DE_MIGHT_IGNORE"/>
    </Match>

    <!-- Generated fixtures and test code -->
    <Match>
        <Or>
            <Class name="~.*Test.*"/>
            <Class name="~.*Mock.*"/>
        </Or>
    </Match>

    <!-- Vendor SDK adapter classes: the vendor API shape is out of our control. -->
    <Match>
        <Or>
            <Class name="~.*OrderHttpClientAdapter.*"/>
            <Class name="~.*OrderGatewayClientRuntime.*"/>
            <Class name="~.*EastcomOrderByteBufWorkaround.*"/>
            <Class name="~.*MockGatewayServer.*"/>
            <Class name="~.*MockOrderHttpSessionClient.*"/>
        </Or>
    </Match>

    <!-- Samples/demo code: accepted demo-quality items; review on next touch.
         - Dead store in parseNegotiationContext (leftover context map)
         - Vacuous instanceof in NotificationPolicy (defensive String check)
         - NegotiationStrategy intentionally shadows the control interface name (sample mirror)
         - Boolean-returning booleanParam helper may return null to signal "unset"
         - handleLogin catches Exception broadly as the demo login boundary
         - doPrivileged warning: SecurityManager is not used by this project -->
    <Match>
        <Or>
            <Class name="~.*NegotiationBaseAgentExecutor.*"/>
            <Class name="~.*NotificationPolicy.*"/>
            <Class name="~.*examples.negotiation.NegotiationStrategy"/>
            <Class name="~.*JdkHttpA2AServer.*"/>
            <Class name="~.*A2ATInitialization.*"/>
        </Or>
        <Bug pattern="DP_CREATE_CLASSLOADER_INSIDE_DO_PRIVILEGED"/>
    </Match>
    <Match>
        <Or>
            <Class name="~.*NegotiationBaseAgentExecutor.*"/>
            <Class name="~.*NotificationPolicy.*"/>
            <Class name="~.*examples.negotiation.NegotiationStrategy"/>
            <Class name="~.*JdkHttpA2AServer.*"/>
        </Or>
    </Match>
</FindBugsFilter>
