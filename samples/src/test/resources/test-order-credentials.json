{
  "profiles": {
    "shared-omc": {
      "bearerAuth": {
        "login_url": "https://omc.example.test/rest/plat/smapp/v1/oauth/token",
        "method": "PUT",
        "request_fields": {
          "grantType": "password",
          "userName": "omc-user",
          "value": "omc-password",
          "ipaddr": "*"
        },
        "token_field": "accessSession",
        "order_token_header": "accessSession",
        "token_ttl": 3600
      }
    }
  },
  "agents": {
    "SPN Domain Agent City1": {
      "profile": "shared-omc",
      "overrides": {
        "bearerAuth": {
          "request_fields": {
            "value": "city1-password"
          }
        }
      }
    },
    "SPN Domain Agent City2": {
      "profile": "shared-omc"
    }
  }
}
