<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.openan.workflow.sdk</groupId>
        <artifactId>workflow-engine-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>workflow-engine-samples</artifactId>
    <packaging>jar</packaging>

    <name>workflow-engine-samples</name>
    <description>Sample applications demonstrating the A2A-T workflow execution SDK</description>

    <dependencies>
        <!-- The workflow execution SDK -->
        <dependency>
            <groupId>dev.openan.workflow.sdk</groupId>
            <artifactId>workflow-engine</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- A2A Java SDK spec-grpc (for StreamResponse, SendMessageRequest, ProtoUtils, ProtoJsonUtils) -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-spec-grpc</artifactId>
            <version>${a2a.java.sdk.version}</version>
        </dependency>
        <!-- A2A-T server SDK (for server-side prompt compliance checking in OMC agents) -->
        <dependency>
            <groupId>net.openan.a2a-t.sdk</groupId>
            <artifactId>a2a-t-server</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- Protobuf JSON formatting (for serializing A2A messages to JSON in gateway adapter) -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
            <version>3.25.5</version>
        </dependency>
        <!-- Eastcom Order SDK (instruction center / gateway platform). -->
        <dependency>
            <groupId>com.eastcom.apollo</groupId>
            <artifactId>order-shaded-client</artifactId>
            <version>1.1.18</version>
        </dependency>
        <!-- Spring Boot starter: auto-assembles A2A server beans, partner only implements AgentExecutor -->
        <dependency>
            <groupId>dev.openan.workflow.sdk</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Logging: Log4j2 (SLF4J 2.x binding) with console + rolling file appender -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Tests must never consume a contributor's local LLM key or call the network. -->
                    <systemPropertyVariables>
                        <a2at.samples.llm.enabled>false</a2at.samples.llm.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
