# A2A-T SDK Configuration
# Copy this file to .env and fill in your values

# Full A2A/Order protocol messages are emitted by the dedicated PROTOCOL DEBUG logger.
# Keep sensitive values hidden by default; set true only during controlled local debugging.
WORKFLOW_ENGINE_PROTOCOL_INCLUDE_SENSITIVE_HEADERS=false
# Set false to omit request/response bodies; large bodies are truncated at this character count.
WORKFLOW_ENGINE_PROTOCOL_INCLUDE_BODY=true
WORKFLOW_ENGINE_PROTOCOL_MAX_BODY_CHARS=100000

# Prompt runtime
A2AT_LANGUAGE=zh-CN
# classpath: prompt_resources are bundled inside the a2a-t-resources jar on the classpath
# local_file: prompt resources are loaded from local filesystem
A2AT_PROMPT_SOURCE_TYPE=classpath
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=

# Prompt compliance
A2AT_PROMPT_COMPLIANCE_ENABLED=false
A2AT_PROMPT_COMPLIANCE_GUARDRAIL_PROVIDER=noop

# LLM runtime
# Supported providers: openai (OpenAI-compatible APIs like DeepSeek, Azure OpenAI, etc.)
# For DeepSeek: use provider=openai with base_url=https://api.deepseek.com
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=deepseek-chat
A2AT_LLM_API_KEY=your-api-key-here
A2AT_LLM_BASE_URL=https://api.deepseek.com
A2AT_LLM_MAX_TOKENS=4000
A2AT_LLM_TEMPERATURE=0
A2AT_LLM_TIMEOUT_SECONDS=60
A2AT_LLM_HISTORY_WINDOW=10
A2AT_LLM_SESSION_MAX_TOTAL=300
A2AT_LLM_SESSION_MAX_PER_PROVIDER=100

# Negotiation
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory

# Credential encryption key (32-byte hex, used for enc: prefixed passwords in credentials JSON)
# Generate with: openssl rand -hex 32
A2AT_CRED_KEY=your-32-byte-hex-key-here

# Direct-mode credentials consumed only by the engine's built-in authentication strategy.
A2A_OMC_CREDENTIALS_PATH=classpath:spn_agent_credentials.json
# Empty uses safe defaults: live Order=false, direct=true, Order simulator=true.
A2A_EMBEDDED_OMC_ENABLED=

# Workbench outbound transport: order (Eastcom SDK), mock, or direct
A2A_TRANSPORT_MODE=order
A2A_MOCK_GATEWAY_URL=http://127.0.0.1:26400

# Eastcom instruction platform. Configure either a default NE or per-agent NE routes.
# true starts the local RSocket-RPC protocol simulator; never enable it in production.
EASTCOM_ORDER_SIMULATOR_ENABLED=false
EASTCOM_ORDER_HOST=10.x.x.x
EASTCOM_ORDER_PORT=0
EASTCOM_ORDER_USERNAME=your-username
EASTCOM_ORDER_PASSWORD=your-password
EASTCOM_ORDER_CLIENT_ID=your-client-id
EASTCOM_ORDER_CLIENT_SECRET=
EASTCOM_ORDER_DEFAULT_NE=
EASTCOM_ORDER_CITY1_NE=city1-omc
EASTCOM_ORDER_CITY2_NE=city2-omc
EASTCOM_ORDER_LOGIN_TIMEOUT_SECONDS=15
EASTCOM_ORDER_TIMEOUT_SECONDS=600

# OMC Bearer authentication through the Eastcom HttpClient route. The instruction platform
# replaces ${ne:username}/${ne:password} with credentials managed for the selected NE.
EASTCOM_ORDER_OMC_AUTH_ENABLED=true
# Used only by the sample fallback Eastcom AuthProvider. A host bean named
# workflowOmcAuthProvider takes precedence and makes this file unnecessary.
EASTCOM_ORDER_OMC_CREDENTIALS_PATH=classpath:spn_agent_credentials.json
EASTCOM_ORDER_OMC_LOGIN_PATH=/rest/plat/smapp/v1/oauth/token
EASTCOM_ORDER_OMC_LOGIN_METHOD=PUT
EASTCOM_ORDER_OMC_TOKEN_RESPONSE_HEADER=bearToken
EASTCOM_ORDER_OMC_REQUEST_AUTH_HEADER=Authorization
EASTCOM_ORDER_OMC_REQUEST_AUTH_SCHEME=Bearer
EASTCOM_ORDER_OMC_TOKEN_TTL_SECONDS=3600
EASTCOM_ORDER_OMC_USERNAME_FIELD=userName
EASTCOM_ORDER_OMC_PASSWORD_FIELD=value
